  "system_name": "Battery Management System ECU",
  "extracted_user_defined_scenarios": [
    {
      "name": "CAN Bus Attack ( spoofing , Flooding Replay Attack)",
      "description": "An attacker connects a malicious device to the vehicle OBD-II port (or compromises the Telematics unit) and sends high-priority CAN frames acting as the \"Charger,\" commanding the BMS to close contactors while the vehicle is not actually connected to a valid station.\r\n\r\n\r\nn attacker places a rouge device on the CAN1 bus. This device records \"low current\" messages from a previous drive cycle and replays them during a fast-charging session. The BMS believes current is low and fails to cut off charging, leading to battery overheating.",
      "id": "39ff9305-9758-4287-9c55-c2da9b489ccf",
